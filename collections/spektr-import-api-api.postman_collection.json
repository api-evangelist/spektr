          "name": "Create dataset",
          "request": {
            "name": "Create dataset",
            "description": {
              "content": "Create a new dataset with a specified schema that allows to be used in processes. The schema defines the structure of data entries. Once created, the dataset becomes available in the platform and can be connected to spektr processes. Optionally, provide a \"parentDatasetId\" to create the dataset as a child of an existing dataset, used for related entities.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
