        "name": "Execution API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute process",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ingest.spektr.com/v1/execution",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Excute a process for a list of spektr IDs. The processId can be found in the spektr platform. The spektr IDs are generated through the Import API."
        },
        {
          "info": {
            "name": "Execute process v2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ingest.spektr.com/v2/execution",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Execute a process for spektr IDs and/or reference IDs. Optionally provide email input and enable token refresh on version mismatch to ensure execution uses the latest process version."
        },
        {
          "info": {
