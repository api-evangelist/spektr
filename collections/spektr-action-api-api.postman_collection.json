        {
          "id": "88f2ca9e-3d85-4736-aa53-45c6f4d5ef8b",
          "name": "Start Onboarding",
          "request": {
            "name": "Start Onboarding",
            "description": {
              "content": "Creates a new onboarding session for your client. You can optionally prefill client data by submitting a payload in the request body. The response includes a session token that you can append to the onboarding URL: https://actions.spektr.com/form?token={token} to direct your client to the onboarding flow. If using a custom domain, replace actions.spektr.com with your domain.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "public",
                "actions",
                "processId",
                ":processId",
                "workspaceId",
                ":workspaceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "reference",
                  "value": "<string>",
                  "description": "Your custom reference ID to track this onboarding session or it can be included in the data payload"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "processId",
                  "description": "(Required) The ID of the onboarding process template"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "workspaceId",
                  "description": "(Required) The ID of your workspace"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional unique key (1–255 chars) to ensure the request is processed only once. If a duplicate key is sent with the same request parameters, the original response is replayed. Replayed responses include the `idempotent-replayed: true` header.",
                "key": "idempotency-key",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Set to 'true' to have the server wait until the onboarding session is ready to accept a submission before responding, so the returned token can be submitted immediately without client-side polling. Defaults to false.",
                "key": "x-spektr-block-until-ready",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"first_name\": \"<string>\",\n    \"last_name\": \"<string>\",\n    \"email\": \"<string>\",\n    \"phone_number\": \"<string>\",\n    \"reference\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
