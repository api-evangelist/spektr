{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spektr Action API API",
    "version": "v2.23"
  },
  "items": [
    {
      "info": {
        "name": "Action API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start Onboarding",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ingest.spektr.com/v1/public/actions/processId/:processId/workspaceId/:workspaceId",
            "headers": [
              {
                "name": "idempotency-key",
                "value": ""
              },
              {
                "name": "x-spektr-block-until-ready",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "processId",
                "value": "",
                "type": "path",
                "description": "The ID of the onboarding process template"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "The ID of your workspace"
              },
              {
                "name": "reference",
                "value": "",
                "type": "query",
                "description": "Your custom reference ID to track this onboarding session or it can be included in the data payload"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new onboarding session for your client. You can optionally prefill client data by submitting a payload in the request body. The response includes a session token that you can append to the onboarding URL: https://actions.spektr.com/form?token={token} to direct your client to the onboarding flow. If using a custom domain, replace actions.spektr.com with your domain."
        }
      ]
    }
  ],
  "bundled": true
}