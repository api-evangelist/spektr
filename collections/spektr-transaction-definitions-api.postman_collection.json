                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"payment-transaction\",\n  \"type\": \"payment\",\n  \"fields\": {\n    \"amount\": \"number\",\n    \"currency\": \"string\",\n    \"sourceIp\": \"ipAddress\",\n    \"sender_iban\": \"string\",\n    \"recipient_iban\": \"string\",\n    \"tags\": \"array\",\n    \"location\": {\n      \"city\": \"string\",\n      \"country\": \"string\"\n    }\n  },\n  \"link\": [\n    {\n      \"type\": \"iban\",\n      \"txPath\": \"sender_iban\",\n      \"clientRecordPath\": \"data.iban\",\n      \"direction\": \"source\"\n    }\n  ],\n  \"partitions\": [\n    {\n      \"type\": \"deviceId\",\n      \"txPath\": \"device_id\"\n    },\n    {\n      \"type\": \"deviceId\",\n      \"txPath\": \"device_id\"\n    }\n  ],\n  \"realTimeFields\": [\n    \"amount\",\n    \"currency\"\n  ]\n}",
                  "options": {
