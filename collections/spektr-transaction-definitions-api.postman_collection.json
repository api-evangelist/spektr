        {
          "id": "30740126-740e-42c2-801f-2dd69e5f8712",
          "name": "Create transaction definition",
          "request": {
            "name": "Create transaction definition",
            "description": {
              "content": "Create a new transaction definition with a nested field schema, customer link declarations, and optional non-client-scoped partitions. Leaf field values must be one of: \"string\", \"number\", \"ipAddress\", \"date\", \"array\". Array fields accept only primitive elements (string, number, boolean, null). Each link txPath and partition txPath must resolve to a declared leaf field (link and partition paths may not target array fields). Partition types must not collide with link types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "transaction-definitions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"type\": \"<string>\",\n  \"fields\": \"<object>\",\n  \"link\": [\n    {\n      \"type\": \"<string>\",\n      \"txPath\": \"<string>\",\n      \"clientRecordPath\": \"<string>\",\n      \"direction\": \"<string>\"\n    }\n  ],\n  \"partitions\": [\n    {\n      \"type\": \"<string>\",\n      \"txPath\": \"<string>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"txPath\": \"<string>\"\n    }\n  ],\n  \"realTimeFields\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
